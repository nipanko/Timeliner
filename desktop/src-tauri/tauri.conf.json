{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TIMELINER",
  "version": "1.0.0",
  "identifier": "com.triedindie.timeliner",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Tried Indie"
  }
}