{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-build",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-web.js",
        "dist",
        "8090"
      ],
      "port": 8090
    }
  ]
}
